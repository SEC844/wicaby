# Normalise line endings: LF in the repository and, for sources, in the working tree.
* text=auto

# Sources and docs: always LF
*.ts         text eol=lf
*.mjs        text eol=lf
*.js         text eol=lf
*.cjs        text eol=lf
*.svelte     text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.kt         text eol=lf
*.kts        text eol=lf
*.xml        text eol=lf
*.svg        text eol=lf
*.pro        text eol=lf
*.properties text eol=lf
*.toml       text eol=lf
*.go         text eol=lf
go.mod       text eol=lf
go.sum       text eol=lf
*.txt        text eol=lf
*.sh         text eol=lf
gradlew      text eol=lf
.editorconfig  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.nvmrc         text eol=lf

# Windows scripts: CRLF
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binaries
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.gif        binary
*.ico        binary
*.ttf        binary
*.woff       binary
*.woff2      binary
*.jar        binary
*.jks        binary
*.keystore   binary
*.aar        binary
*.apk        binary
*.exe        binary
*.dll        binary
*.7z         binary
*.zip        binary
*.cbz        binary
*.mkv        binary
*.mp4        binary

