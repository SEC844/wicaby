<?xml version="1.0" encoding="utf-8"?>
<!-- gplay flavour only: the Cast SDK reads its options from here (cast spec CA-10); Android Auto (MU-12). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android Auto voice search (MEDIA_PLAY_FROM_SEARCH, onSearch) is optional in MU-12 and not offered: browse only. -->
    <application tools:ignore="MissingIntentFilterForMediaSearch">
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.wika.wicaby.mobile.cast.WicabyCastOptions" />
        <!-- Android Auto (music spec MU-12), gplay only: the music browse tree of PlaybackService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
