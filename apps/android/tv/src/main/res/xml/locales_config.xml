<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language (Android 13+ system settings, and Réglages > Interface > Langue).
     French is the default resource locale (res/values); English is res/values-en. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="fr" />
    <locale android:name="en" />
</locale-config>
