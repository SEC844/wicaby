<?xml version="1.0" encoding="UTF-8"?>
<!-- Tizen TV package manifest. scripts/package-wgt.mjs fills in the version from the repository's package.json. The
     ids are the web TV app's, so this package updates an installed earlier build in place. The floor is Tizen 4
     (2018 models): the app's bundle targets Chromium 53. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="urn:wicaby:webtv" version="0.0.0" viewmodes="maximized">
  <tizen:application id="WicabyWeb1.Wicaby" package="WicabyWeb1" required_version="4.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>Wicaby</name>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <!-- A controller's volume commands ("Play on", X-06). -->
  <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
  <!-- A remote trailer opens in the TV's YouTube app (platform openUrl). -->
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <!-- The user's media servers can be anywhere on the network. -->
  <access origin="*" subdomains="true"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
