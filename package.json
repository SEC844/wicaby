{
  "name": "wicaby-monorepo",
  "version": "0.10.13",
  "description": "Wicaby: media clients for Emby and Jellyfin (Windows and Linux desktop, Android TV, Android mobile)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop --",
    "build": "npm run build -w apps/desktop",
    "start": "npm start -w apps/desktop",
    "check": "npm run check -w apps/desktop && npm run check:webtv",
    "checks": "node tools/checks/run-all.mjs",
    "dist": "npm run dist -w apps/desktop",
    "dist:portable": "npm run dist:portable -w apps/desktop",
    "dist:linux": "npm run dist:linux -w apps/desktop",
    "fetch-mpv": "npm run fetch-mpv -w apps/desktop",
    "icon": "node brand/scripts/make-icon.mjs",
    "dev:webtv": "vite --config apps/webtv/vite.config.ts",
    "build:webtv": "vite build --config apps/webtv/vite.config.ts",
    "build:webtv-demo": "node apps/webtv/scripts/demo-data.mjs && vite build --config apps/webtv/vite.config.ts --mode demo && node tools/release/licenses.mjs apps/webtv/dist/demo/licenses",
    "package:webtv": "node apps/webtv/scripts/package.mjs",
    "check:webtv": "svelte-check --tsconfig apps/webtv/tsconfig.json --threshold error",
    "build:mesh": "node packages/mesh/scripts/build-vpn-helper.mjs",
    "build:mesh-aar": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/mesh/scripts/build-mesh-aar.ps1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
