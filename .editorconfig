root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,gradle,java}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
